# Webhook de Make.com para el formulario de contacto
# Obtener en: Make.com > Webhooks > mundologico-contacto
MAKE_WEBHOOK_URL=https://hook.us1.make.com/REEMPLAZAR_CON_URL_REAL

# Cloudflare Turnstile (anti-bots del formulario). Secret Key del widget mundologico-contacto.
# Obtener en: dash.cloudflare.com > Turnstile > mundologico-contacto > Settings
TURNSTILE_SECRET_KEY=REEMPLAZAR_CON_SECRET_KEY

# Opcional: llaves de prueba de Cloudflare para desarrollo local.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Opcional: secreto que se manda a Make en el header x-ml-secret.
# El escenario debe filtrar y descartar lo que no lo traiga.
MAKE_WEBHOOK_SECRET=


# Bandera del agente de voz Federico (/demos-ml/agente-voz). Escenario de Make que responde GET con {"enabled": true|false}.
# Solo servidor: nunca con prefijo NEXT_PUBLIC. Si falta o falla, el demo queda apagado.
MAKE_DEMO_ESTADO_URL=https://hook.us1.make.com/REEMPLAZAR_CON_URL_REAL

# Agente de voz de ElevenLabs para el agente de voz Federico (/demos-ml/agente-voz) (público: va al navegador en el widget).
# Obtener en: elevenlabs.io > Agents > Federico > ID del agente. Se fija en el build.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
